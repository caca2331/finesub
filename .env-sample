# 填明文即可：Windows 上首次运行会自动加密（绑定当前 Windows 账户），变成：
#   # FineSub 主密钥：绑定当前 Windows 账户，勿手动修改或删除。
#   FINESUB_KEYRING=finesub$kek$v1$...
#   GEMINI_FREE={"name-of-key1":"fs$...","name-of-key2":"fs$..."}
# 导出明文：finesub keys --reveal（换机/重装 Windows 前先导出）
GEMINI_FREE={"name-of-key1":"key1","name-of-key2":"key2"}
GEMINI_PAID={}
EXA_KEYS={"exa1":"key1"}
TAVILY_KEYS={"tvly1":"key1","tvly2":"key2","tvly3":"key3"}
