-
-    const auto source_length = history.dim(-1);
+  struct BeamAttentionNode {
+    int32_t parent = -1;
+    size_t row = 0;
+  };
+
+  static std::vector<std::vector<float>>
+  build_attention_from_lineage(const std::vector<BeamAttentionNode>& nodes,
+                               const std::vector<float>& rows,
+                               const dim_t vector_size,
+                               int32_t node_id,
+                               const dim_t start,
+                               const dim_t end) {
+    std::vector<size_t> lineage;
+    while (node_id >= 0) {
+      const auto& node = nodes[node_id];
+      lineage.emplace_back(node.row);
+      node_id = node.parent;
+    }
+    std::reverse(lineage.begin(), lineage.end());
 
+    const dim_t safe_start = std::min<dim_t>(start, lineage.size());
+    const dim_t safe_end = std::min<dim_t>(end, lineage.size());
     std::vector<std::vector<float>> attention;
-    attention.reserve(end - start);
-    for (dim_t t = start; t < end; ++t) {
-      const auto* vector = history.index<float>({batch, beam, t, 0});
-      attention.emplace_back(vector, vector + source_length);
+    attention.reserve(safe_end - safe_start);
+    for (dim_t t = safe_start; t < safe_end; ++t) {
+      const float* row = rows.data() + lineage[t] * vector_size;
+      attention.emplace_back(row, row + vector_size);
     }
     return attention;
   }
 
+  static std::vector<float> build_token_logprobs(const StorageView& history,
+                                                 const dim_t batch,
+                                                 const dim_t beam,
+                                                 const dim_t start,
+                                                 const dim_t end) {
+    if (!history)
+      return {};
+
+    const auto* values = history.index<float>({batch, beam, 0});
+    return std::vector<float>(values + start, values + end);
+  }
