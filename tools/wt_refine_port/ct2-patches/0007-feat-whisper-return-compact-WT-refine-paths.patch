+    static std::vector<WhisperRefineAlignmentResult>
+    compute_refine_alignments(const std::vector<size_t>& hypothesis,
+                              const std::vector<std::vector<float>>& attention,
+                              const size_t attention_heads,
+                              const size_t attention_frames,
+                              const std::vector<StorageView>& tail_logprobs,
+                              const size_t timestamp_begin,
+                              const size_t eot,
+                              const size_t refine_frames,
+                              const size_t real_audio_frames) {
+      if (hypothesis.empty() || attention.empty())
+        return {};
+
+      const bool has_eot = hypothesis.back() == eot;
+      const size_t decoded_length = hypothesis.size() - (has_eot ? 1 : 0);
+      std::vector<size_t> boundaries;
+      for (size_t i = 1; i < decoded_length; ++i) {
+        if (hypothesis[i - 1] >= timestamp_begin && hypothesis[i] >= timestamp_begin)
+          boundaries.emplace_back(i);
+      }
+      const bool single_timestamp_ending = (
+        decoded_length >= 2
+        && hypothesis[decoded_length - 2] < timestamp_begin
+        && hypothesis[decoded_length - 1] >= timestamp_begin);
+      if (single_timestamp_ending)
+        boundaries.emplace_back(decoded_length);
+      if (boundaries.empty()
+          && has_eot
+          && decoded_length >= 2
+          && hypothesis[0] >= timestamp_begin
+          && hypothesis[decoded_length - 1] < timestamp_begin)
+        boundaries.emplace_back(hypothesis.size());
+
+      std::vector<WhisperRefineAlignmentResult> results;
+      size_t start = 0;
+      for (const size_t end : boundaries) {
+        if (end <= start + 2 || end > hypothesis.size()) {
+          start = end;
+          continue;
+        }
+        WhisperRefineAlignmentResult result;
+        result.token_start = start;
+        result.token_end = end - 1;
+        result.alignment_tokens.assign(hypothesis.begin() + start, hypothesis.begin() + end);
+        if (result.alignment_tokens.front() < timestamp_begin) {
+          start = end;
+          continue;
+        }
+
+        if (result.alignment_tokens.back() >= timestamp_begin
+            && result.alignment_tokens.back() <= result.alignment_tokens.front()) {
+          if (result.token_end + (has_eot ? 1 : 0) != hypothesis.size() - 1) {
+            start = end;
+            continue;
+          }
+          const size_t row_from_end = has_eot ? 2 : 1;
+          if (tail_logprobs.size() < row_from_end) {
+            start = end;
+            continue;
+          }
+          const StorageView& row = tail_logprobs[tail_logprobs.size() - row_from_end];
+          const size_t first = result.alignment_tokens.front() + 1;
+          if (first >= size_t(row.size())) {
+            start = end;
+            continue;
+          }
+          const float* values = row.data<float>();
+          const float* best = std::max_element(values + first, values + row.size());
+          result.alignment_tokens.back() = first + std::distance(values + first, best);
+        }
+
+        const size_t rows = result.alignment_tokens.size();
+        if (result.token_end >= attention.size()) {
+          start = end;
+          continue;
+        }
+        std::vector<float> flattened;
+        flattened.reserve(attention_heads * rows * attention_frames);
+        for (size_t head = 0; head < attention_heads; ++head) {
+          for (size_t token = result.token_start; token <= result.token_end; ++token) {
+            const auto& step = attention[token];
+            const size_t offset = head * attention_frames;
+            if (step.size() < offset + attention_frames)
+              throw std::runtime_error("Incomplete WT attention step");
+            flattened.insert(flattened.end(),
+                             step.begin() + offset,
+                             step.begin() + offset + attention_frames);
+          }
+        }
+        StorageView attention_view(
+          Shape{1, dim_t(attention_heads), dim_t(rows), dim_t(attention_frames)},
+          flattened);
+
+        const size_t start_position = result.alignment_tokens.front() - timestamp_begin;
+        size_t end_position = attention_frames;
+        if (result.alignment_tokens.back() >= timestamp_begin) {
+          end_position = result.alignment_tokens.back() - timestamp_begin;
+          end_position = std::max(end_position, start_position + rows);
+        }
+        const dim_t frame_start = std::max<dim_t>(0, dim_t(start_position) - refine_frames);
+        const dim_t frame_end = std::min<dim_t>(
+          attention_frames,
+          dim_t(end_position) + refine_frames);
+        if (frame_end <= frame_start) {
+          start = end;
+          continue;
+        }
+        const size_t real_frames = real_audio_frames == 0
+          ? attention_frames
+          : std::min(real_audio_frames, attention_frames);
+        std::vector<size_t> dummy_text(rows - 1, 0);
+        result.alignments = compute_alignments(
+          attention_view,
+          {},
+          {std::move(dummy_text)},
+          9,
+          {{frame_start, frame_end}},
+          {real_frames},
+          false,
+          true,
+          true,
+          true)[0];
+        results.emplace_back(std::move(result));
+        start = end;
+      }
+      return results;
+    }
+
     std::vector<WhisperAlignmentResult>
     WhisperReplica::align(StorageView features,
                           const std::vector<size_t>& start_sequence,
