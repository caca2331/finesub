     static std::vector<std::vector<std::pair<dim_t, dim_t>>>
     compute_alignments(StorageView& attention_probs,
                        const std::vector<size_t>& start_sequence,
                        const std::vector<std::vector<size_t>>& text_tokens,
                        const dim_t median_filter_width,
                        const std::vector<std::pair<dim_t, dim_t>>& frame_ranges = {},
+                       bool use_boundary_queries = false,
+                       bool use_wt_attention_postprocessing = false,
                        bool encourage_early = false,
                        bool allow_empty_subwords = true) {
-      const ops::MedianFilter median_filter_op(median_filter_width);
+      const ops::MedianFilter median_filter_op(
+        median_filter_width,
+        /*duplicate_edge=*/use_wt_attention_postprocessing);
       const dim_t batch_size = attention_probs.dim(0);
 
+      if (use_wt_attention_postprocessing) {
+        std::vector<std::vector<std::pair<dim_t, dim_t>>> alignments;
+        alignments.reserve(batch_size);
+
+        for (dim_t b = 0; b < batch_size; ++b) {
+          const dim_t text_length = text_tokens[b].size();
+          const dim_t sot_length = start_sequence.size();
+          const dim_t row_start = use_boundary_queries ? sot_length - 1 : sot_length;
+          const dim_t n_rows = text_length + (use_boundary_queries ? 2 : 1);
+          const dim_t total_frames = attention_probs.dim(3);
+
+          dim_t frame_start = 0;
+          dim_t frame_end = total_frames;
+          if (!frame_ranges.empty() && b < dim_t(frame_ranges.size())) {
+            frame_start = std::max(dim_t(0), frame_ranges[b].first);
+            frame_end = std::min(total_frames, frame_ranges[b].second);
+            if (frame_end <= frame_start) {
+              frame_start = 0;
+              frame_end = total_frames;
+            }
+          }
+          const dim_t frame_len = frame_end - frame_start;
+
+          StorageView batch_id({1}, int32_t(b), attention_probs.device());
+          StorageView selected(attention_probs.dtype(), attention_probs.device());
+          ops::Gather()(attention_probs, batch_id, selected);
+          slice_axis(selected, 2, row_start, n_rows);
+          slice_axis(selected, 3, frame_start, frame_len);
+          selected = selected.to(DataType::FLOAT32);
+
+          StorageView filtered(selected.dtype(), selected.device());
+          median_filter_op(selected, filtered);
+          ops::SoftMax()(filtered);
+
+          StorageView weights(filtered.dtype(), filtered.device());
+          ops::Mean(1)(filtered, weights);
+          synchronize_stream(weights.device());
+          weights.move_to(Device::CPU, DataType::FLOAT32);
+
+          StorageView matrix(Shape{n_rows, frame_len}, DataType::FLOAT32);
+          const float* src = weights.index<float>({0, 0, 0});
+          float* dst = matrix.data<float>();
+          std::copy(src, src + n_rows * frame_len, dst);
+
+          // WT normalizes each frame across the selected token rows after
+          // averaging the configured alignment heads.
+          for (dim_t f = 0; f < frame_len; ++f) {
+            float squared_norm = 0;
+            for (dim_t t = 0; t < n_rows; ++t) {
+              const float value = dst[t * frame_len + f];
+              squared_norm += value * value;
+            }
+            const float norm = std::sqrt(squared_norm);
+            if (norm > 0) {
+              for (dim_t t = 0; t < n_rows; ++t)
+                dst[t * frame_len + f] /= norm;
+            }
+          }
+
+          auto dtw_result = negative_dtw(matrix, encourage_early, allow_empty_subwords);
+          if (frame_start > 0) {
+            for (auto& [text_idx, time_idx] : dtw_result)
+              time_idx += frame_start;
+          }
+          alignments.emplace_back(std::move(dtw_result));
+        }
+
+        return alignments;
+      }
