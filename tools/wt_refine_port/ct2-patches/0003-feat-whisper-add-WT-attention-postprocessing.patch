+    static void slice_axis(StorageView& x, dim_t axis, dim_t start, dim_t size) {
+      const dim_t max_size = x.dim(axis);
+      if (start < 0 || size < 0 || start + size > max_size)
+        throw std::invalid_argument("Invalid attention slice");
+
+      if (start > 0) {
+        StorageView prefix(x.dtype(), x.device());
+        StorageView suffix(x.dtype(), x.device());
+        const ops::Split split_op(axis, {start, max_size - start});
+        split_op(x, prefix, suffix);
+        x = std::move(suffix);
+      }
+
+      if (size < x.dim(axis)) {
+        StorageView content(x.dtype(), x.device());
+        StorageView suffix(x.dtype(), x.device());
+        const ops::Split split_op(axis, {size, x.dim(axis) - size});
+        split_op(x, content, suffix);
+        x = std::move(content);
+      }
+    }
