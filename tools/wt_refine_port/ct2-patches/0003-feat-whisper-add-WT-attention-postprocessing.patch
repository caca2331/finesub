-              if (read >= depth)
-                read = depth - (read - depth) - 2;
+              dim_t read = j + k;
+              if (_duplicate_edge) {
+                // scipy.ndimage mode="reflect" (half-sample symmetric):
+                // d c b a | a b c d | d c b a
+                if (read < 0)
+                  read = -read - 1;
+                if (read >= depth)
+                  read = 2 * depth - read - 1;
+              } else {
+                // PyTorch reflect / scipy mode="mirror" (whole-sample):
+                // d c b | a b c d | c b a
+                read = std::abs(read);
+                if (read >= depth)
+                  read = depth - (read - depth) - 2;
+              }
               window[k + rank] = in[read];
             }
 
