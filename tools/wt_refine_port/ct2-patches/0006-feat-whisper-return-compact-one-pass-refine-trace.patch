       }
     };
 
+    class RefineTailLogprobs : public LogitsProcessor {
+    public:
+      explicit RefineTailLogprobs(const size_t batch_size)
+        : _tail(batch_size) {
+      }
+
+      void apply(dim_t,
+                 StorageView& logits,
+                 DisableTokens& disable_tokens,
+                 const StorageView&,
+                 const std::vector<dim_t>& batch_offset,
+                 const std::vector<std::vector<size_t>>*) override {
+        // This collector runs after Whisper's timestamp processor. Apply every
+        // pending mask, then retain only the final two filtered rows on GPU.
+        // The normal sampler already computes LogSoftMax; avoid repeating it
+        // at every step and normalize the two retained rows in take().
+        disable_tokens.apply();
+        for (dim_t i = 0; i < logits.dim(0); ++i) {
+          const size_t batch_id = batch_offset[i];
+          StorageView row(logits.dtype(), logits.device());
+          if (logits.dim(0) == 1) {
+            row.copy_from(logits);
+          } else {
+            StorageView gather_id({1}, int32_t(i), logits.device());
+            ops::Gather()(logits, gather_id, row);
+          }
+          row.squeeze(0);
+          auto& tail = _tail[batch_id];
+          if (tail.size() == 2)
+            tail.erase(tail.begin());
+          tail.emplace_back(std::move(row));
+        }
+      }
+
+      std::vector<StorageView> take(const size_t batch_id) {
+        std::vector<StorageView> result;
+        result.reserve(_tail[batch_id].size());
+        for (auto& row : _tail[batch_id]) {
+          ops::LogSoftMax()(row);
+          result.emplace_back(row.to_float32().to(Device::CPU));
+        }
+        return result;
+      }
+
+    private:
+      std::vector<std::vector<StorageView>> _tail;
+    };
+
     std::vector<WhisperGenerationResult>
     WhisperReplica::generate(StorageView features,
                              const std::vector<std::vector<size_t>>& prompts,
@@ -237,6 +285,20 @@ namespace ctranslate2 {
