@@ -362,6 +441,33 @@ namespace ctranslate2 {
         final_result.sequences_ids = std::move(result.hypotheses);
         final_result.scores = std::move(result.scores);
         final_result.logits = std::move(result.logits_vocab);
+        final_result.attention = std::move(result.attention);
+        if (options.return_refine_trace) {
+          final_result.token_logprobs = std::move(token_logprobs[i]);
+          final_result.tail_logprobs = refine_tail_logprobs->take(i);
+        }
+        if (return_alignment_attention && !final_result.attention.empty()
+            && !final_result.attention[0].empty()) {
+          final_result.attention_frames = state.at("memory_keys_0").dim(-2);
+          final_result.attention_heads = (
+            final_result.attention[0][0].size() / final_result.attention_frames);
+          for (size_t j = 0; j < final_result.sequences_ids.size(); ++j) {
+            auto& hypothesis = final_result.sequences_ids[j];
+            if (!hypothesis.empty() && hypothesis.back() == _eot_id) {
+              const size_t length_with_eot = hypothesis.size();
+              hypothesis.pop_back();
+              if (j < final_result.scores.size() && !hypothesis.empty()
+                  && options.length_penalty != 0) {
+                final_result.scores[j] *= std::pow(
+                  static_cast<float>(length_with_eot) / hypothesis.size(),
+                  options.length_penalty);
+              }
+            }
+          }
+          final_result.sequences = vocabulary.to_tokens(final_result.sequences_ids);
+        }
+        if (!options.return_scores)
+          final_result.scores.clear();
         if (options.return_no_speech_prob)
           final_result.no_speech_prob = no_speech_probs[i];
 
