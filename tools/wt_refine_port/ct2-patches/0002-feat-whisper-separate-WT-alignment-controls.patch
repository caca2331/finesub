diff --git a/tests/dtw_test.cc b/tests/dtw_test.cc
new file mode 100644
index 0000000..def0348
--- /dev/null
+++ b/tests/dtw_test.cc
@@ -0,0 +1,46 @@
+#include "test_utils.h"
+
+#include "dtw.h"
+
+namespace {
+
+using Alignment = std::vector<std::pair<dim_t, dim_t>>;
+
+void expect_alignment_eq(const Alignment& got, const Alignment& expected) {
+  ASSERT_EQ(got.size(), expected.size());
+  for (size_t i = 0; i < got.size(); ++i) {
+    EXPECT_EQ(got[i], expected[i]) << "Alignment mismatch at index " << i;
+  }
+}
+
+}  // namespace
+
+TEST(DtwTest, MatchesWhisperTimestampedSymmetric1) {
+  // Oracle: dtw-python stepPattern.symmetric1, as used by
+  // whisper-timestamped 1.15.9 when subwords_can_be_empty=True.
+  const StorageView weights(
+    {3, 3},
+    std::vector<float>{
+      0.9f, 0.1f, 0.0f,
+      0.8f, 0.2f, 0.1f,
+      0.1f, 0.7f, 0.9f,
+    });
+
+  expect_alignment_eq(
+    negative_dtw(weights, /*encourage_early=*/false, /*allow_empty_subwords=*/true),
+    Alignment{{0, 0}, {1, 0}, {1, 1}, {2, 1}, {2, 2}});
+}
+
+TEST(DtwTest, CanDisallowEmptySubwordsIndependently) {
+  const StorageView weights(
+    {3, 3},
+    std::vector<float>{
+      0.9f, 0.1f, 0.0f,
+      0.8f, 0.2f, 0.1f,
+      0.1f, 0.7f, 0.9f,
+    });
+
+  expect_alignment_eq(
+    negative_dtw(weights, /*encourage_early=*/true, /*allow_empty_subwords=*/false),
+    Alignment{{0, 0}, {1, 1}, {2, 2}});
+}
