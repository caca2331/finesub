               options.refine_frames,
-              options.real_audio_frames);
+              options.real_audio_frames,
+              options.return_refine_weights);
           }
           for (size_t j = 0; j < final_result.sequences_ids.size(); ++j) {
             auto& hypothesis = final_result.sequences_ids[j];
@@ -570,7 +576,8 @@ namespace ctranslate2 {
                        bool use_boundary_queries,
                        bool use_wt_attention_postprocessing,
                        bool encourage_early,
-                       bool allow_empty_subwords) {
