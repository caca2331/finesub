From 8eb2248566a973c16a00a6b8b65bbc8b23c80b7a Mon Sep 17 00:00:00 2001
From: caca2331 <spurtcarl@gmail.com>
Date: Sat, 1 Aug 2026 12:40:14 -0700
Subject: [PATCH 10/11] feat(whisper): expose refine weights for disfluencies

---
 include/ctranslate2/models/whisper.h |  7 ++++++
 python/cpp/whisper.cc                | 10 +++++++-
 src/models/whisper.cc                | 34 +++++++++++++++++++++++-----
 3 files changed, 44 insertions(+), 7 deletions(-)

diff --git a/include/ctranslate2/models/whisper.h b/include/ctranslate2/models/whisper.h
index a69069c..e097482 100644
--- a/include/ctranslate2/models/whisper.h
+++ b/include/ctranslate2/models/whisper.h
@@ -54,6 +54,10 @@ namespace ctranslate2 {
       // Supports greedy or beam search when returning one hypothesis.
       bool return_refine_paths = false;
 
+      // Include the postprocessed token-frame weights used by WT disfluency
+      // detection. Requires return_refine_paths.
+      bool return_refine_weights = false;
+
       // Number of encoder frames added on each side of a decoded timestamp span.
       size_t refine_frames = 50;
 
@@ -80,6 +84,9 @@ namespace ctranslate2 {
       bool unfinished = false;
       std::vector<size_t> alignment_tokens;
       std::vector<std::pair<dim_t, dim_t>> alignments;
+      size_t alignment_frame_start = 0;
+      size_t alignment_frame_end = 0;
+      std::vector<float> alignment_weights;
     };
 
     struct WhisperGenerationResult {
diff --git a/python/cpp/whisper.cc b/python/cpp/whisper.cc
