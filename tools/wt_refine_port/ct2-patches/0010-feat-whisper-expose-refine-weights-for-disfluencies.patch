                bool return_no_speech_prob,
@@ -69,6 +70,7 @@ namespace ctranslate2 {
         options.return_attention = return_attention;
         options.return_refine_trace = return_refine_trace;
         options.return_refine_paths = return_refine_paths;
+        options.return_refine_weights = return_refine_weights;
         options.refine_frames = refine_frames;
         options.real_audio_frames = real_audio_frames;
         options.return_no_speech_prob = return_no_speech_prob;
@@ -174,7 +176,10 @@ namespace ctranslate2 {
         .def_readonly("token_end", &models::WhisperRefineAlignmentResult::token_end)
         .def_readonly("unfinished", &models::WhisperRefineAlignmentResult::unfinished)
         .def_readonly("alignment_tokens", &models::WhisperRefineAlignmentResult::alignment_tokens)
-        .def_readonly("alignments", &models::WhisperRefineAlignmentResult::alignments);
+        .def_readonly("alignments", &models::WhisperRefineAlignmentResult::alignments)
+        .def_readonly("alignment_frame_start", &models::WhisperRefineAlignmentResult::alignment_frame_start)
+        .def_readonly("alignment_frame_end", &models::WhisperRefineAlignmentResult::alignment_frame_end)
+        .def_readonly("alignment_weights", &models::WhisperRefineAlignmentResult::alignment_weights);
 
       py::class_<models::WhisperGenerationResult>(m, "WhisperGenerationResult",
                                                   "A generation result from the Whisper model.")
@@ -329,6 +334,7 @@ namespace ctranslate2 {
              py::arg("return_attention")=false,
              py::arg("return_refine_trace")=false,
              py::arg("return_refine_paths")=false,
+             py::arg("return_refine_weights")=false,
              py::arg("refine_frames")=50,
              py::arg("real_audio_frames")=0,
              py::arg("return_no_speech_prob")=false,
@@ -370,6 +376,8 @@ namespace ctranslate2 {
                    return_refine_paths: Return compact WT DTW paths and logits without exposing
                      the full attention trace. Supports greedy or beam search when returning one
                      hypothesis.
+                   return_refine_weights: Include postprocessed token-frame weights for WT
+                     disfluency detection. Requires return_refine_paths.
                    refine_frames: Encoder-frame margin added around each timestamp span.
                    real_audio_frames: Number of real encoder frames before padding (0 means all).
                    return_no_speech_prob: Include the probability of the no speech token in the
diff --git a/src/models/whisper.cc b/src/models/whisper.cc
