-          true)[0];
+          true,
+          return_refine_weights ? &alignment_weights : nullptr)[0];
+        if (return_refine_weights) {
+          result.alignment_frame_start = size_t(frame_start);
+          result.alignment_frame_end = size_t(frame_end);
+          if (!alignment_weights.empty())
+            result.alignment_weights = std::move(alignment_weights.front());
+        }
         results.emplace_back(std::move(result));
         start = end;
       }
