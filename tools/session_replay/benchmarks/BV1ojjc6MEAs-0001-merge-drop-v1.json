  "sources": [
    {
      "id": "1",
      "start": 2.5,
      "duration": 4.6,
      "text": "その遺産、受け取ったわ、アラン。"
    },
    {
      "id": "2",
      "start": 12.6,
      "duration": 2.2,
      "text": "待って、なにこのアニメ!"
    },
    {
      "id": "3",
      "start": 21.2,
      "duration": 3.3,
      "text": "ちょ、終わった。一回待ったよ。"
    },
    {
      "id": "4",
      "start": 26.2,
      "duration": 2.2,
      "text": "ほんまに?新書に変わってる。あ、ほんとだ。"
    },
    {
      "id": "5",
      "start": 30.3,
      "duration": 1.2,
      "text": "ネジがやっぱ分かりやすいな"
    },
    {
      "id": "6",
      "start": 32.5,
      "duration": 0.3,
      "text": "えっ?"
    },
    {
      "id": "7",
      "start": 34.8,
      "duration": 0.5,
      "text": "じゃあ"
    },
    {
      "id": "8",
      "start": 36.5,
      "duration": 1.3,
      "text": "なんかがなんかして"
    },
    {
      "id": "9",
      "start": 38.1,
      "duration": 1.5,
      "text": "最後の遺産が"
    },
    {
      "id": "10",
      "start": 39.8,
      "duration": 1.1,
      "text": "時が来て"
    },
    {
      "id": "11",
      "start": 41.0,
      "duration": 1.0,
      "text": "それを得て"
    },
    {
      "id": "12",
      "start": 45.1,
      "duration": 1.1,
      "text": "こうなるって"
    },
    {
      "id": "13",
      "start": 47.6,
      "duration": 0.4,
      "text": "こと?"
    },
    {
      "id": "14",
      "start": 48.2,
      "duration": 0.7,
      "text": "え、まさか"
    },
    {
      "id": "15",
      "start": 49.2,
      "duration": 2.3,
      "text": "アランギヨタンの最後の遺産が"
    },
    {
      "id": "16",
      "start": 51.6,
      "duration": 0.4,
      "text": "この"
    },
    {
      "id": "17",
      "start": 52.3,
      "duration": 2.9,
      "text": "神スキンだったとは誰も思ってなかったと思うんだけど"
    },
    {
      "id": "18",
      "start": 60.7,
      "duration": 1.6,
      "text": "ちょ、言いたいこといっぱいあるわ"
    },
    {
      "id": "19",
      "start": 62.6,
      "duration": 3.2,
      "text": "なんか、すごい濃厚じゃなかった"
    },
    {
      "id": "20",
      "start": 69.8,
      "duration": 3.8,
      "text": "あの、まずアランギヨタンを見せてくれてありがとうっていう点"
    },
    {
      "id": "21",
      "start": 77.5,
      "duration": 1.8,
      "text": "ちょっと待ってくださいよー!"
    },
    {
      "id": "22",
      "start": 79.3,
      "duration": 2.8,
      "text": "マジで!なんかうちらアランギオタンのさー"
    },
    {
      "id": "23",
      "start": 82.3,
      "duration": 1.2,
      "text": "少年期と"
    },
    {
      "id": "24",
      "start": 84.1,
      "duration": 0.8,
      "text": "このー"
    },
    {
      "id": "25",
      "start": 85.1,
      "duration": 0.8,
      "text": "老年?"
    },
    {
      "id": "26",
      "start": 86.1,
      "duration": 1.9,
      "text": "少年期よりももた後の"
    },
    {
      "id": "27",
      "start": 88.5,
      "duration": 2.6,
      "text": "老いたギオタンはこの微齢な"
    },
    {
      "id": "28",
      "start": 92.0,
      "duration": 2.0,
      "text": "オリジナルの状態見ることができたけど"
    },
    {
      "id": "29",
      "start": 94.3,
      "duration": 3.8,
      "text": "おそらく青年期と思われるマレシオセファントムの時のアランギオタンだけ"
    },
    {
      "id": "30",
      "start": 98.2,
      "duration": 1.6,
      "text": "NPC顔でしか知らないじゃん"
    },
    {
      "id": "31",
      "start": 99.8,
      "duration": 0.7,
      "text": "でもそれも"
    },
    {
      "id": "32",
      "start": 100.8,
      "duration": 1.6,
      "text": "新しくしてほしいってね"
    },
    {
      "id": "33",
      "start": 105.4,
      "duration": 1.4,
      "text": "ごめん、普通に欲望出ちゃった?"
    },
    {
      "id": "34",
      "start": 108.2,
      "duration": 3.1,
      "text": "多分あの、ヌビレットの回想シーンの"
    },
    {
      "id": "35",
      "start": 112.2,
      "duration": 1.7,
      "text": "やつだと思われているじゃん今"
    },
    {
      "id": "36",
      "start": 115.0,
      "duration": 5.6,
      "text": "えーちょっとさー、なん、えーもう、あらんぎよたーん"
    },
    {
      "id": "37",
      "start": 125.1,
      "duration": 4.7,
      "text": "ちょっと、この感情を明確に言葉にすることができない"
    },
    {
      "id": "38",
      "start": 130.2,
      "duration": 1.5,
      "text": "切ないが近いです今"
    },
    {
      "id": "39",
      "start": 137.7,
      "duration": 1.1,
      "text": "なんか赤色が"
    },
    {
      "id": "40",
      "start": 139.3,
      "duration": 3.1,
      "text": "4章記憶魂人格願いの"
    },
    {
      "id": "41",
      "start": 142.5,
      "duration": 4.1,
      "text": "願いに相当する赤色が新衣装に差し込まれたと見ていますね"
    },
    {
      "id": "42",
      "start": 146.6,
      "duration": 2.4,
      "text": "調査班の報告きた"
    },
    {
      "id": "43",
      "start": 150.3,
      "duration": 0.9,
      "text": "でもわかりやすい"
    },
    {
      "id": "44",
      "start": 157.6,
      "duration": 2.3,
      "text": "前の衣装と比べようとか思ったんだけど"
    },
    {
      "id": "45",
      "start": 160.1,
      "duration": 2.1,
      "text": "ここで止まっちゃうなどうしようこれ"
    },
    {
      "id": "46",
      "start": 162.3,
      "duration": 1.5,
      "text": "可愛すぎるっつーか"
    },
    {
      "id": "47",
      "start": 164.3,
      "duration": 1.1,
      "text": "なんでロザリンの"
    },
    {
      "id": "48",
      "start": 167.0,
      "duration": 1.3,
      "text": "うちらをどうしたいのこれで?"
    },
    {
      "id": "49",
      "start": 171.1,
      "duration": 1.6,
      "text": "ねえロザリー綺麗すぎる"
    },
    {
      "id": "50",
      "start": 173.0,
      "duration": 3.0,
      "text": "ファーストコンタクトが最悪だったせいでさ"
    },
    {
      "id": "51",
      "start": 176.3,
      "duration": 3.0,
      "text": "まあファーストコンタクトの時胸でっかとは言ったんですけど僕は"
    },
    {
      "id": "52",
      "start": 179.3,
      "duration": 3.1,
      "text": "だからもう本当に早く殺してくださいねって話で"
    },
    {
      "id": "53",
      "start": 183.8,
      "duration": 4.1,
      "text": "こうやって仲いい奴と一緒にいる面を見るとさ"
    },
    {
      "id": "54",
      "start": 187.8,
      "duration": 1.4,
      "text": "マジで見方変わっちゃうよな"
    },
    {
      "id": "55",
      "start": 189.2,
      "duration": 1.0,
      "text": "博士もそうだった"
    },
    {
      "id": "56",
      "start": 190.4,
      "duration": 2.8,
      "text": "なんか最後にニョキッと出てきた未亡人との会話で"
    },
    {
      "id": "57",
      "start": 193.4,
      "duration": 1.5,
      "text": "え?お前みたいな"
    },
    {
      "id": "58",
      "start": 198.3,
      "duration": 2.4,
      "text": "なんでどっちも失ってから気づくん"
    },
    {
      "id": "59",
      "start": 201.0,
      "duration": 1.3,
      "text": "でもそういうもんなんだよね"
    },
    {
      "id": "60",
      "start": 203.0,
      "duration": 3.8,
      "text": "えーちょっとねえ顔面した後普通にこの4人でホールケーキを"
    },
    {
      "id": "61",
      "start": 208.9,
      "duration": 2.8,
      "text": "結構いくね"
    },
    {
      "id": "62",
      "start": 216.0,
      "duration": 1.5,
      "text": "よく考えたらさ"
    },
    {
      "id": "63",
      "start": 217.5,
      "duration": 5.0,
      "text": "まあそんなにデカくないとはいえ高さがあるホールケーキを4人で4等分"
    },
    {
      "id": "64",
      "start": 222.8,
      "duration": 2.0,
      "text": "記憶願いたましい人格ってことね"
    },
    {
      "id": "65",
      "start": 227.5,
      "duration": 2.5,
      "text": "パジャマで部屋に集まり直して"
    },
    {
      "id": "66",
      "start": 231.1,
      "duration": 3.5,
      "text": "ワンパクなサイズのケーキを4人でってのは想像以上だし"
    },
    {
      "id": "67",
      "start": 234.6,
      "duration": 1.6,
      "text": "あとさ、そのー"
    },
    {
      "id": "68",
      "start": 236.4,
      "duration": 2.7,
      "text": "サンドローネってケーキ食えるんだね"
    },
    {
      "id": "69",
      "start": 240.0,
      "duration": 1.4,
      "text": "まあ紅茶飲んでるのは"
    },
    {
      "id": "70",
      "start": 242.9,
      "duration": 0.8,
      "text": "見てたけど"
    },
    {
      "id": "71",
      "start": 244.3,
      "duration": 1.4,
      "text": "え、ちょ、もう"
    },
    {
      "id": "72",
      "start": 250.2,
      "duration": 3.5,
      "text": "いや、このニコニコシニョーラ、"
    },
    {
      "id": "73",
      "start": 254.6,
      "duration": 1.7,
      "text": "可愛すぎるっしょ"
    },
    {
      "id": "74",
      "start": 260.4,
      "duration": 5.9,
      "text": "はぁ、もう、この世界は間違ってるっす"
    },
    {
      "id": "75",
      "start": 270.0,
      "duration": 3.4,
      "text": "ねぇ、この世界は間違ってると思わない?"
    },
    {
      "id": "76",
      "start": 275.1,
      "duration": 2.0,
      "text": "誰かが悲しい目に遭った理由。"
    },
    {
      "id": "77",
      "start": 279.0,
      "duration": 5.0,
      "text": "なんかどうしようもない炎で全てを焼き尽くしたくなるような目に遭うのがやっぱり間違って"
    },
    {
      "id": "78",
      "start": 284.2,
      "duration": 1.5,
      "text": "この世界はいびつなんだよ"
    },
    {
      "id": "79",
      "start": 285.7,
      "duration": 3.8,
      "text": "だからこの世界の歪みに気づいた時に終点で待ってるってこと"
    },
    {
      "id": "80",
      "start": 293.3,
      "duration": 2.4,
      "text": "ねえ天理に物申したいことなんですけど"
    },
    {
      "id": "81",
      "start": 299.4,
      "duration": 3.9,
      "text": "ちょっともう一回もう一回さそのオーディオコメンタリーいい?"
    },
    {
      "id": "82",
      "start": 303.7,
      "duration": 2.8,
      "text": "一回目は若干涙で見えなかったとこあるから"
    },
    {
      "id": "83",
      "start": 307.4,
      "duration": 1.5,
      "text": "あーと音量大丈夫そうだった?"
    },
    {
      "id": "84",
      "start": 309.7,
      "duration": 2.4,
      "text": "ここでロサリンが女皇の理想に共感できるっていう時"
    },
    {
      "id": "85",
      "start": 312.3,
      "duration": 3.2,
      "text": "英語だと神の目を表すビジョンでその後に願いはないのって聞いてて"
    },
    {
      "id": "86",
      "start": 315.6,
      "duration": 1.8,
      "text": "こう全てがサンドロールの獲得する願い"
    },
    {
      "id": "87",
      "start": 317.4,
      "duration": 3.5,
      "text": "神の身もとい星のくさびについての話に動線が引かれていて早口"
    },
    {
      "id": "88",
      "start": 323.4,
      "duration": 0.9,
      "text": "落ち着け"
    },
    {
      "id": "89",
      "start": 324.6,
      "duration": 2.3,
      "text": "いやでも全て理解しましたし"
    },
    {
      "id": "90",
      "start": 326.9,
      "duration": 1.2,
      "text": "綿抜きも結構そう思ってた"
    },
    {
      "id": "91",
      "start": 328.5,
      "duration": 0.8,
      "text": "やっぱこう"
    },
    {
      "id": "92",
      "start": 330.1,
      "duration": 3.1,
      "text": "座標の時と同じく願いを獲得しないと"
    },
    {
      "id": "93",
      "start": 333.7,
      "duration": 1.0,
      "text": "神の目っていうの"
    },
    {
      "id": "94",
      "start": 334.7,
      "duration": 1.1,
      "text": "願いを獲得するっていうか"
    },
    {
      "id": "95",
      "start": 335.8,
      "duration": 3.5,
      "text": "渇望が神の目を得るきっかけなわけだから"
    },
    {
      "id": "96",
      "start": 340.0,
      "duration": 1.4,
      "text": "他人の願いのために"
    },
    {
      "id": "97",
      "start": 342.0,
      "duration": 0.9,
      "text": "身を滅ぼしたり"
    },
    {
      "id": "98",
      "start": 343.0,
      "duration": 2.5,
      "text": "世界を救うために自己犠牲をするなんて"
    },
    {
      "id": "99",
      "start": 345.4,
      "duration": 2.1,
      "text": "バカバカしいっていうサンドローネが"
    },
    {
      "id": "100",
      "start": 347.8,
      "duration": 2.4,
      "text": "果たして何の渇望により"
    },
    {
      "id": "101",
      "start": 350.7,
      "duration": 1.0,
      "text": "星のくさびさん"
    },
    {
      "id": "102",
      "start": 355.2,
      "duration": 2.0,
      "text": "まずそっから知らない概念でやばい"
    },
    {
      "id": "103",
      "start": 357.5,
      "duration": 1.6,
      "text": "終えるのかっていうね"
    },
    {
      "id": "104",
      "start": 360.0,
      "duration": 0.7,
      "text": "なぁ"
    },
    {
      "id": "105",
      "start": 366.6,
      "duration": 1.4,
      "text": "音量大手もそうありがとう"
    },
    {
      "id": "106",
      "start": 371.6,
      "duration": 3.3,
      "text": "え、そうドゥリンがモンドにした時に"
    },
    {
      "id": "107",
      "start": 375.1,
      "duration": 2.9,
      "text": "ルータンがそこで死んじゃったからドゥリンが悪いかって言ったら"
    },
    {
      "id": "108",
      "start": 378.0,
      "duration": 1.3,
      "text": "ドゥリンは別に悪くないんだよね"
    },
    {
      "id": "109",
      "start": 379.6,
      "duration": 1.8,
      "text": "ドゥリンを作った奴がいるらしいな"
    },
    {
      "id": "110",
      "start": 382.7,
      "duration": 0.9,
      "text": "ちょっと待ってごめん"
    },
    {
      "id": "111",
      "start": 383.9,
      "duration": 2.4,
      "text": "ドゥリンを作ったレインドットがいなかったらさ"
    },
    {
      "id": "112",
      "start": 388.2,
      "duration": 2.9,
      "text": "マリアンは、まあ死んでないかもしれないじゃん"
    },
    {
      "id": "113",
      "start": 391.2,
      "duration": 0.8,
      "text": "いやまあわかんないけど"
    },
    {
      "id": "114",
      "start": 392.6,
      "duration": 2.3,
      "text": "メリージーヌも生まれないわけじゃん"
    },
    {
      "id": "115",
      "start": 395.4,
      "duration": 2.7,
      "text": "まあレインドットがいなかった場合のテイワットを考える時点で"
    },
    {
      "id": "116",
      "start": 398.2,
      "duration": 2.6,
      "text": "根底が覆るからだいぶその過程は無理があるけど"
    },
    {
      "id": "117",
      "start": 401.2,
      "duration": 0.7,
      "text": "それで"
    },
    {
      "id": "118",
      "start": 403.1,
      "duration": 2.0,
      "text": "マリアンを失ってなかったら"
    },
    {
      "id": "119",
      "start": 406.1,
      "duration": 3.1,
      "text": "サンドローネは作られてなかったかもしれないって思うと"
    },
    {
      "id": "120",
      "start": 409.7,
      "duration": 3.3,
      "text": "世界を否定した時、サンドローネは生まれないのか?"
    },
    {
      "id": "121",
      "start": 413.4,
      "duration": 1.5,
      "text": "え?私どうしたらいい?"
    },
    {
      "id": "122",
      "start": 416.5,
      "duration": 0.7,
      "text": "うわああああ"
    },
    {
      "id": "123",
      "start": 420.8,
      "duration": 2.9,
      "text": "決闘代理人っていうシステムが本体にはあるやん"
    },
    {
      "id": "124",
      "start": 423.8,
      "duration": 4.1,
      "text": "だから午前試合も私が死にょうらの代理人として出ればよかった"
    },
    {
      "id": "125",
      "start": 440.0,
      "duration": 4.1,
      "text": "待って、あったかもしれない可能性で身を焦がすのってアビスか"
    },
    {
      "id": "126",
      "start": 444.9,
      "duration": 0.1,
      "text": "ん"
    },
    {
      "id": "127",
      "start": 445.0,
      "duration": 2.1,
      "text": "ん"
    },
    {
      "id": "128",
      "start": 448.7,
      "duration": 0.2,
      "text": "ん"
    },
    {
      "id": "129",
      "start": 450.4,
      "duration": 1.1,
      "text": "ん"
    },
    {
      "id": "130",
      "start": 451.7,
      "duration": 0.1,
      "text": "ん"
    },
    {
      "id": "131",
      "start": 453.4,
      "duration": 1.8,
      "text": "朝っ腹からどういうつもり"
    },
    {
      "id": "132",
      "start": 455.5,
      "duration": 1.5,
      "text": "歌わないでって言ったでしょ"
    },
    {
      "id": "133",
      "start": 457.1,
      "duration": 2.0,
      "text": "てかパジャマ怖いすぎだね"
    },
    {
      "id": "134",
      "start": 459.7,
      "duration": 2.0,
      "text": "執行官の会議の日だから"
    },
    {
      "id": "135",
      "start": 462.2,
      "duration": 2.8,
      "text": "寝坊してないか心配で見に来たの"
    },
    {
      "id": "136",
      "start": 465.9,
      "duration": 1.5,
      "text": "ノックを知らないの?"
    },
    {
      "id": "137",
      "start": 467.8,
      "duration": 6.2,
      "text": "知ってる。でもうなされてる気がしたから心が落ち着くかなって"
    },
    {
      "id": "138",
      "start": 475.1,
      "duration": 1.2,
      "text": "あ、あと"
    },
    {
      "id": "139",
      "start": 477.4,
      "duration": 1.4,
      "text": "そのパジャマ姿が"
    },
    {
      "id": "140",
      "start": 479.5,
      "duration": 4.8,
      "text": "ここ何を言おうとしたかっていううちらに問いかけをしてるんだよね"
    },
    {
      "id": "141",
      "start": 485.2,
      "duration": 0.7,
      "text": "ほよっちも"
    },
    {
      "id": "142",
      "start": 488.8,
      "duration": 2.8,
      "text": "最近、原神の変な検証ばっかしてる動画見てて、"
    },
    {
      "id": "143",
      "start": 491.7,
      "duration": 3.4,
      "text": "ホヨッチってよく揃う人が言うから、もう私もホヨッチって言うようになっちゃった"
    },
    {
      "id": "144",
      "start": 496.2,
      "duration": 1.5,
      "text": "二人きりの時はミホヨって呼んでる"
    },
    {
      "id": "145",
      "start": 500.5,
      "duration": 4.2,
      "text": "何気にさ、アニメーションの作画力がすごくない?"
    },
    {
      "id": "146",
      "start": 507.2,
      "duration": 2.9,
      "text": "この角度、上手すぎるよね"
    },
    {
      "id": "147",
      "start": 513.5,
      "duration": 1.7,
      "text": "この頃ミーナでも思ったけど"
    },
    {
      "id": "148",
      "start": 517.8,
      "duration": 3.6,
      "text": "斜め下から見た時の横顔"
    },
    {
      "id": "149",
      "start": 521.4,
      "duration": 1.9,
      "text": "斜め45度みたいな顔"
    },
    {
      "id": "150",
      "start": 524.2,
      "duration": 2.1,
      "text": "これ素晴らしいですよ"
    },
    {
      "id": "151",
      "start": 530.9,
      "duration": 2.4,
      "text": "大丈夫?サンドローネ"
    },
    {
      "id": "152",
      "start": 536.8,
      "duration": 1.0,
      "text": "平気だから"
    },
    {
      "id": "153",
      "start": 540.0,
      "duration": 4.9,
      "text": "歯車は何気に同じ角度で繋がってるのも綺麗"
    },
    {
      "id": "154",
      "start": 546.1,
      "duration": 0.9,
      "text": "平気だから…"
    },
    {
      "id": "155",
      "start": 550.8,
      "duration": 2.3,
      "text": "あと、まとめてるとはあんまり気づかなかったけど、"
    },
    {
      "id": "156",
      "start": 553.3,
      "duration": 2.9,
      "text": "思った以上に後ろ髪のボリュームは大きくて可愛いな"
    },
    {
      "id": "157",
      "start": 559.6,
      "duration": 0.3,
      "text": "うん"
    },
    {
      "id": "158",
      "start": 560.8,
      "duration": 1.6,
      "text": "これは割と勘違いされがちなんですけど"
    },
    {
      "id": "159",
      "start": 562.4,
      "duration": 1.9,
      "text": "ロザリンってモンド時代そこまで憎んでないというか"
    },
    {
      "id": "160",
      "start": 564.2,
      "duration": 3.1,
      "text": "ルースターを失ってから憎んでいたのは主にこの世界時代だったんですよね"
    },
    {
      "id": "161",
      "start": 567.3,
      "duration": 1.5,
      "text": "人を憎んではいなかったんですよね"
    },
    {
      "id": "162",
      "start": 569.0,
      "duration": 2.2,
      "text": "ただ強い憎しみの炎で身を焦がしたロザリンが"
    },
    {
      "id": "163",
      "start": 571.2,
      "duration": 2.2,
      "text": "最終的に氷の女皇と出会い共感し"
    },
    {
      "id": "164",
      "start": 573.6,
      "duration": 1.5,
      "text": "再び人として生き始めたのを"
    },
    {
      "id": "165",
      "start": 575.1,
      "duration": 1.9,
      "text": "ここの二人も相当熱いと睨んでいます"
    },
    {
      "id": "166",
      "start": 579.0,
      "duration": 0.9,
      "text": "汗なず"
    },
    {
      "id": "167",
      "start": 582.8,
      "duration": 4.1,
      "text": "みんなワタネキがナルトの説明してって言った時ぐらい早口やん"
    },
    {
      "id": "168",
      "start": 587.0,
      "duration": 2.5,
      "text": "でもワタネキも全く同じこと思ってて"
    },
    {
      "id": "169",
      "start": 591.3,
      "duration": 5.1,
      "text": "いや正確には世界自体を恨むように見落としてしまったシニョーラが"
    },
    {
      "id": "170",
      "start": 597.0,
      "duration": 4.8,
      "text": "そんな中普通の顔してこうやってお茶会とかをしてる自立が"
    },
    {
      "id": "171",
      "start": 604.5,
      "duration": 1.1,
      "text": "エモイもなんだよね"
    },
    {
      "id": "172",
      "start": 606.6,
      "duration": 0.8,
      "text": "でも違う"
    },
    {
      "id": "173",
      "start": 607.5,
      "duration": 2.8,
      "text": "エモいというには悲しすぎるんだけど"
    },
    {
      "id": "174",
      "start": 610.5,
      "duration": 1.7,
      "text": "人間ってそうだよな"
    },
    {
      "id": "175",
      "start": 612.3,
      "duration": 1.8,
      "text": "深い絶望の中にあっても"
    },
    {
      "id": "176",
      "start": 614.4,
      "duration": 3.1,
      "text": "普通に笑ったりできちゃうんだよねっていうのがね"
    },
    {
      "id": "177",
      "start": 618.8,
      "duration": 0.3,
      "text": "大丈夫?"
    },
    {
      "id": "178",
      "start": 620.2,
      "duration": 0.9,
      "text": "サンドローネ"
    },
    {
      "id": "179",
      "start": 624.7,
      "duration": 0.8,
      "text": "平気だから"
    },
    {
      "id": "180",
      "start": 628.8,
      "duration": 0.5,
      "text": "本当だ!"
    },
    {
      "id": "181",
      "start": 629.3,
      "duration": 1.8,
      "text": "全然赤の割合しないな"
    },
    {
      "id": "182",
      "start": 631.2,
      "duration": 2.1,
      "text": "服だと"
    },
    {
      "id": "183",
      "start": 634.5,
      "duration": 1.4,
      "text": "問題ないさ"
    },
    {
      "id": "184",
      "start": 636.1,
      "duration": 1.2,
      "text": "あの、あとね、このもう"
    },
    {
      "id": "185",
      "start": 637.4,
      "duration": 0.6,
      "text": "うちらは"
    },
    {
      "id": "186",
      "start": 639.1,
      "duration": 1.3,
      "text": "パブロフの犬だから"
    },
    {
      "id": "187",
      "start": 640.8,
      "duration": 2.3,
      "text": "これがドゥルルンって流れた瞬間に"
    },
    {
      "id": "188",
      "start": 643.2,
      "duration": 1.6,
      "text": "一回涙ぐんでしまって"
    },
    {
      "id": "189",
      "start": 645.0,
      "duration": 1.6,
      "text": "ろくに喋れなくなっちゃうの"
    },
    {
      "id": "190",
      "start": 649.3,
      "duration": 0.9,
      "text": "でーん"
    },
    {
      "id": "191",
      "start": 650.3,
      "duration": 1.0,
      "text": "でーん"
    },
    {
      "id": "192",
      "start": 655.2,
      "duration": 1.4,
      "text": "これ禁止カードだろ"
    },
    {
      "id": "193",
      "start": 657.0,
      "duration": 0.4,
      "text": "でも…"
    },
    {
      "id": "194",
      "start": 658.2,
      "duration": 1.2,
      "text": "さっき先生が…"
    },
    {
      "id": "195",
      "start": 661.0,
      "duration": 1.0,
      "text": "あ、あ、あ、あ、あ"
    },
    {
      "id": "196",
      "start": 666.8,
      "duration": 3.2,
      "text": "ん"
    },
    {
      "id": "197",
      "start": 672.6,
      "duration": 1.5,
      "text": "何かできることはある"
    },
    {
      "id": "198",
      "start": 676.6,
      "duration": 0.7,
      "text": "欲しいも"
    },
    {
      "id": "199",
      "start": 678.3,
      "duration": 0.9,
      "text": "てかこれ"
    },
    {
      "id": "200",
      "start": 679.9,
      "duration": 0.9,
      "text": "もうすぐ"
    },
    {
      "id": "201",
      "start": 682.3,
      "duration": 1.4,
      "text": "午前0時なのか"
    },
    {
      "id": "202",
      "start": 684.2,
      "duration": 0.7,
      "text": "あーなんか"
    },
    {
      "id": "203",
      "start": 686.8,
      "duration": 2.2,
      "text": "時計の針落ちた時のこと思い出して"
    },
    {
      "id": "204",
      "start": 689.0,
      "duration": 0.6,
      "text": "もう全部"
    },
    {
      "id": "205",
      "start": 689.8,
      "duration": 1.8,
      "text": "日常の全部がトリガーになって"
    },
    {
      "id": "206",
      "start": 691.7,
      "duration": 0.7,
      "text": "苦しい"
    },
    {
      "id": "207",
      "start": 694.2,
      "duration": 1.5,
      "text": "こんなはずじゃなかったのに"
    },
    {
      "id": "208",
      "start": 695.7,
      "duration": 0.4,
      "text": "今日は"
    },
    {
      "id": "209",
      "start": 696.2,
      "duration": 1.2,
      "text": "ものはないかい"
    },
    {
      "id": "210",
      "start": 698.6,
      "duration": 1.6,
      "text": "あなたに元気でいてほしい"
    },
    {
      "id": "211",
      "start": 701.3,
      "duration": 2.1,
      "text": "はっはっはっは"
    },
    {
      "id": "212",
      "start": 703.4,
      "duration": 1.5,
      "text": "貴重なチャンスを"
    },
    {
      "id": "213",
      "start": 705.3,
      "duration": 2.2,
      "text": "老いぼれに使うものじゃない"
    },
    {
      "id": "214",
      "start": 709.0,
      "duration": 0.7,
      "text": "来なさい"
    },
    {
      "id": "215",
      "start": 710.0,
      "duration": 2.7,
      "text": "貴重なチャンスをってのは気になるな"
    },
    {
      "id": "216",
      "start": 713.5,
      "duration": 2.8,
      "text": "貴重な時間をって意味なんでしょうか"
    },
    {
      "id": "217",
      "start": 716.6,
      "duration": 1.7,
      "text": "あなたに元気でいてほしい"
    },
    {
      "id": "218",
      "start": 718.3,
      "duration": 3.4,
      "text": "欲しいものがちに何でも与えられる技術力の持ち主だから"
    },
    {
      "id": "219",
      "start": 722.4,
      "duration": 4.0,
      "text": "この問いに元気でいてっていうのを言われたら、なんかま、まじでワンチャン!"
    },
    {
      "id": "220",
      "start": 727.0,
      "duration": 6.2,
      "text": "人間の肉体を生き延び、生き流れさせることは難しいかもしれないけど、"
    },
    {
      "id": "221",
      "start": 733.5,
      "duration": 1.8,
      "text": "アランギヨタンの技術だったら、"
    },
    {
      "id": "222",
      "start": 736.1,
      "duration": 3.1,
      "text": "まあ半分ぐらいそれに近いことはできるのかもしれないよな"
    },
    {
      "id": "223",
      "start": 739.6,
      "duration": 3.5,
      "text": "でも人間として彼は死ぬことを選んだんだよね"
    },
    {
      "id": "224",
      "start": 746.2,
      "duration": 3.9,
      "text": "貴重なチャンスを追いぼれに使うものじゃない"
    },
    {
      "id": "225",
      "start": 751.2,
      "duration": 2.9,
      "text": "来なさい見せたいものがある"
    },
    {
      "id": "226",
      "start": 756.6,
      "duration": 1.4,
      "text": "紹介しよう"
    },
    {
      "id": "227",
      "start": 758.8,
      "duration": 3.2,
      "text": "新しく発明したプロニアだ"
    },
    {
      "id": "228",
      "start": 769.6,
      "duration": 5.2,
      "text": "おやすみなさい"
    },
    {
      "id": "229",
      "start": 775.2,
      "duration": 6.4,
      "text": "女皇陛下の偉大なる計画に神の心は欠かせない"
    },
    {
      "id": "230",
      "start": 783.8,
      "duration": 3.0,
      "text": "財政はパンタローネに一人する"
    },
    {
      "id": "231",
      "start": 788.1,
      "duration": 0.6,
      "text": "本当だ"
    },
    {
      "id": "232",
      "start": 791.0,
      "duration": 1.8,
      "text": "あちょっと一回涙拭くんだけど"
    },
    {
      "id": "233",
      "start": 795.9,
      "duration": 3.0,
      "text": "聞いたことある不運が入ってたな"
    },
    {
      "id": "234",
      "start": 801.2,
      "duration": 1.7,
      "text": "頃は欠かせない"
    },
    {
      "id": "235",
      "start": 805.0,
      "duration": 2.9,
      "text": "財政はパンタローネに一人する"
    },
    {
      "id": "236",
      "start": 810.2,
      "duration": 3.8,
      "text": "なんか言い切る前にフライングでちょっと笑ってますしね"
    },
    {
      "id": "237",
      "start": 817.5,
      "duration": 1.9,
      "text": "そのー"
    },
    {
      "id": "238",
      "start": 820.9,
      "duration": 0.9,
      "text": "あれですか?"
    },
    {
      "id": "239",
      "start": 822.4,
      "duration": 1.0,
      "text": "自分が"
    },
    {
      "id": "240",
      "start": 825.3,
      "duration": 3.9,
      "text": "まあ見つけてきた奴がここまで登り詰めたことに対する"
    },
    {
      "id": "241",
      "start": 829.7,
      "duration": 2.8,
      "text": "ちょっと若干優越もありの"
    },
    {
      "id": "242",
      "start": 832.6,
      "duration": 2.7,
      "text": "あとパントローネが財政一任されてると"
    },
    {
      "id": "243",
      "start": 836.1,
      "duration": 1.9,
      "text": "自分のあれこれが通りやすくなるから"
    },
    {
      "id": "244",
      "start": 838.6,
      "duration": 1.9,
      "text": "ラッキーみたいなのでもあり"
    },
    {
      "id": "245",
      "start": 840.8,
      "duration": 1.5,
      "text": "っていう風運ですかこれは"
    },
    {
      "id": "246",
      "start": 844.9,
      "duration": 1.8,
      "text": "ちょっとかかり気味になりそう私"
    },
    {
      "id": "247",
      "start": 847.6,
      "duration": 2.2,
      "text": "今だいぶ重ババ、重ババなんですけど"
    },
    {
      "id": "248",
      "start": 850.7,
      "duration": 3.8,
      "text": "技術面で何かがあればサンドローネにし"
    },
    {
      "id": "249",
      "start": 856.3,
      "duration": 2.6,
      "text": "ふーんの次はホアが出ちゃった"
    },
    {
      "id": "250",
      "start": 862.0,
      "duration": 2.3,
      "text": "え?このファティス可愛すぎないか?"
    },
    {
      "id": "251",
      "start": 864.8,
      "duration": 1.3,
      "text": "なんだ?可愛い!"
    },
    {
      "id": "252",
      "start": 869.8,
      "duration": 2.0,
      "text": "あんたがそんなに可愛いから"
    },
    {
      "id": "253",
      "start": 872.5,
      "duration": 2.3,
      "text": "厳選初期を支えたボーイズラブの"
    },
    {
      "id": "254",
      "start": 874.9,
      "duration": 1.0,
      "text": "片割れになっちゃうんだよ"
    },
    {
      "id": "255",
      "start": 879.7,
      "duration": 0.5,
      "text": "てか"
    },
    {
      "id": "256",
      "start": 880.5,
      "duration": 1.6,
      "text": "さっきパパベルトが厳選始めたって"
    },
    {
      "id": "257",
      "start": 882.1,
      "duration": 1.3,
      "text": "ちょっと前に言ったんですけど"
    },
    {
      "id": "258",
      "start": 883.4,
      "duration": 2.2,
      "text": "リーウェイが終わったらしいんですよ"
    },
    {
      "id": "259",
      "start": 885.9,
      "duration": 2.5,
      "text": "ね、最初はタルタリアあんま好きじゃなかったけど"
    },
    {
      "id": "260",
      "start": 888.8,
      "duration": 1.3,
      "text": "最終的にこう"
    },
    {
      "id": "261",
      "start": 890.8,
      "duration": 3.5,
      "text": "割と勝利先生の手のひらの上だったのが可愛くて"
    },
    {
      "id": "262",
      "start": 894.6,
      "duration": 1.5,
      "text": "ちょっと好きになったって言ってて"
    },
    {
      "id": "263",
      "start": 896.4,
      "duration": 4.5,
      "text": "あれ、一定以上の年齢が上の人からは"
    },
    {
      "id": "264",
      "start": 902.0,
      "duration": 5.3,
      "text": "やっぱ、手のひらでコロコロされて生き通ってるのかわいいなって思うみたいで"
    },
    {
      "id": "265",
      "start": 907.5,
      "duration": 2.9,
      "text": "貴重なサンプルデータをありがとうって、思"
    },
    {
      "id": "266",
      "start": 913.2,
      "duration": 1.3,
      "text": "いましたね"
    },
    {
      "id": "267",
      "start": 915.8,
      "duration": 1.4,
      "text": "天狗求めよ、"
    },
    {
      "id": "268",
      "start": 919.2,
      "duration": 1.3,
      "text": "サンドローネ"
    },
    {
      "id": "269",
      "start": 921.6,
      "duration": 6.2,
      "text": "あとこの、コロンミーナが呼ばれたわけじゃなくてサンドローネが呼ばれてるときに"
    },
    {
      "id": "270",
      "start": 928.3,
      "duration": 4.4,
      "text": "どうしたんだろうって、目をやるコロンミーナかわいいですね"
    },
    {
      "id": "271",
      "start": 934.3,
      "duration": 0.5,
      "text": "はぁ?"
    },
    {
      "id": "272",
      "start": 937.4,
      "duration": 2.3,
      "text": "はぁ…わかったわ"
    },
    {
      "id": "273",
      "start": 942.9,
      "duration": 3.3,
      "text": "一元のオイラでした。一元のあんた可愛すぎるだろ"
    },
    {
      "id": "274",
      "start": 948.0,
      "duration": 0.4,
      "text": "えぇ?"
    },
    {
      "id": "275",
      "start": 951.0,
      "duration": 3.8,
      "text": "あんた今すぐアイドルかファドゥーになったほうがいいわよ。可愛すぎるから"
    },
    {
      "id": "276",
      "start": 957.0,
      "duration": 2.1,
      "text": "あとその…博士は…"
    },
    {
      "id": "277",
      "start": 960.2,
      "duration": 6.1,
      "text": "で、タルタリアは…だけ収録して帰ったのかどうか、これやっぱ気になりますよね"
    },
    {
      "id": "278",
      "start": 968.5,
      "duration": 6.7,
      "text": "博士は、その魔人任務のボイス収録中に、こう、切り抜いたらこの不運手に入りそうだけど、"
    },
    {
      "id": "279",
      "start": 975.5,
      "duration": 1.9,
      "text": "ホアアアはなさそうだもんな。"
    },
    {
      "id": "280",
      "start": 987.3,
      "duration": 1.5,
      "text": "うっとうしいわね"
    },
    {
      "id": "281",
      "start": 991.7,
      "duration": 0.9,
      "text": "すごいよね"
    },
    {
      "id": "282",
      "start": 994.5,
      "duration": 2.5,
      "text": "アニメキャラの下打ちはチッ"
    },
    {
      "id": "283",
      "start": 997.6,
      "duration": 0.6,
      "text": "だけど"
    },
    {
      "id": "284",
      "start": 998.5,
      "duration": 2.7,
      "text": "ティナリとサンドローネはなんだよね"
    },
    {
      "id": "285",
      "start": 1004.3,
      "duration": 1.5,
      "text": "うっとうしいわね"
    },
    {
      "id": "286",
      "start": 1009.8,
      "duration": 1.0,
      "text": "どうしたの?"
    }
  ]
}
