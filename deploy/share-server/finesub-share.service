# /etc/systemd/system/finesub-share.service
# 共享知识库服务（deploy/share-server/README.md）。token 别写进这里的仓库副本——
# 用 `systemctl edit finesub-share` 的 override 注入 FINESUB_SHARE_MAINTAINER_TOKEN。
[Unit]
Description=FineSub knowledge share server
After=network.target

[Service]
Type=simple
User=finesub
Group=finesub
Environment=PYTHONUNBUFFERED=1
# override 提供: Environment=FINESUB_SHARE_MAINTAINER_TOKEN=...
ExecStart=/usr/bin/python3 -m finesub.llm.knowledge.share.server \
    --root /var/lib/finesub-share --port 8787 \
    --maintainer-token ${FINESUB_SHARE_MAINTAINER_TOKEN}
Restart=on-failure
RestartSec=3

# hardening: 服务只该碰自己的数据目录
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/finesub-share
PrivateTmp=true

[Install]
WantedBy=multi-user.target
