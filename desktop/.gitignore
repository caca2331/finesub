# The root project intentionally ignores JSON/TXT data files broadly. Desktop
# keeps its manifests and metadata reviewable, with the real release key local.
!**/*.json
!**/*.txt
resources/trusted-update-keys.json

frontend/node_modules/
frontend/.next/
frontend/out/
frontend/*.tsbuildinfo
backend/tests/.tmp-*/
**/dist/
**/build/
installer/output/
