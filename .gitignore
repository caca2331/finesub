__pycache__/
.pytest_cache/
*.egg-info/
*.pyc
*.pyo

.DS_Store
Thumbs.db

.venv/
.env
# Lock/temp sidecars from the .env protection layer (never .env-sample: the
# pattern needs a literal dot after "env").
.env.*
/config.toml
# The data-root catalog override (paths.resolve_model_catalog_override).
# Anchored: the packaged one at src/finesub/llm/routing/ must stay tracked.
/model_catalog.psv
.state
.state.lock
.state.tmp
logs/
.task-activity.lock
.task-activity/
agent-sessions.jsonl
# Where each multi-source run left its queue, so `--resume-batch` can find one
# without being told an id. Runtime state, like the two above.
batches.json
batches.json.lock
*.bak
*.log

/drafts/
/legacy/
/assets/
# Inputs and reference material, including hand-made ones (annotations, refined
# subtitles). Never cleared by a rerun, unlike /out/ and /tmp/.
/data/
/out/
/tmp/

# Local knowledge base: tracked by its own embedded git repo, not the main repo.
# The lock sits beside it rather than inside, so that auto-apply commits cannot
# sweep it up -- which puts it in this repository's tree instead.
/knowledge/
/knowledge.lock

# Local-only notes: tracked on `dev` so worktrees and fresh clones get them,
# stripped from every public snapshot by scripts/publish-main.ps1. gitignore
# cannot express "ignored on one branch" -- a tracked file is tracked
# everywhere -- so the exclusion lives in the publisher, not here.

.qoder/
.workbuddy/
/dist/
/build/

# Managed-install layout created when a launcher runs from this checkout.
/app/
/runtime/
/models/
/user-data/
/cache/

# media files
*.wav
*.mp3
*.flac
*.m4a
*.ogg
*.opus
*.srt
*.ass
*.mkv
*.mp4
*.atpj

# Local sidecar of the confidence explorer (the tracked index.html carries a
# build-time snapshot instead). Plain *.txt is deliberately NOT ignored: a
# blanket rule silently swallows any new tracked text file.
/tools/asr-confidence-explorer/index.txt
# Claude Code 本地配置与运行时状态：默认整个 .claude/ 不入库，逐项放行几个值得在
# worktree / 新 clone 之间共享的文件。放行的这些由 scripts/publish-main.ps1 在发布时
# 从公开快照里剥掉，run-audit 除外——CLAUDE.md 引用它作为产物/知识库审计入口，必须
# 随仓库公开分发。settings.local.json 留在忽略里：它带本机权限与环境变量。
# 逐层放行是 gitignore 的硬性要求：父目录被排除后，子目录无法再被 ! 重新包含。
.claude/*
!.claude/settings.json
!.claude/launch.json

# Pre-compiled tokcount: published as the tokcount-* GitHub Release, no longer tracked
/bin/
